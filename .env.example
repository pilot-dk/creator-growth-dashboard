# Copy this file to `.env` and fill in your own keys, then rebuild.
#
# `.env` is gitignored — keys baked into your local build never reach the
# public repo. If you leave any of these blank the app still works; it just
# falls back to asking for that credential in Settings.
#
# See README "Setup" for how to obtain each of these.

# --- Required for YouTube public stats (subscribers, videos, views) ---
# A plain YouTube Data API v3 key. No OAuth consent screen involved.
# https://console.cloud.google.com/apis/credentials → Create credentials → API key
MAIN_VITE_YOUTUBE_API_KEY=

# --- Required for all Twitch features ---
# From https://dev.twitch.tv/console/apps/create
# OAuth Redirect URL can be set to http://localhost — it is never used, since
# the app authenticates as itself (client-credentials app access token) rather
# than as you.
MAIN_VITE_TWITCH_CLIENT_ID=
MAIN_VITE_TWITCH_CLIENT_SECRET=

# --- Optional: only needed for YouTube per-video retention curves ---
# An OAuth client ID of type "Desktop app" from the same Google Cloud project.
# Leave blank to disable the retention feature entirely.
MAIN_VITE_GOOGLE_OAUTH_CLIENT_ID=
MAIN_VITE_GOOGLE_OAUTH_CLIENT_SECRET=
